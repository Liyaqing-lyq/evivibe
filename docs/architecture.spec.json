  "cards": [
    {
      "dot": "cyan",
      "title": "证据绑定（核心创新）",
      "items": [
        "每条评审结论必须引用证据池中的 Evidence ID",
        "bind_evidence 校验引用是否全部可解析",
        "soft 模式：未绑定结论置信度 ×0.25",
        "strict 模式：直接丢弃未绑定结论"
      ]
    },
    {
      "dot": "rose",
      "title": "硬门槛（两段式协议）",
      "items": [
        "G1 启动 / 构建成功",
        "G2 核心任务通过率达阈值（默认 1.0）",
        "G3 仅证据绑定的高危安全问题才拦截",
        "G4 数据持久化（可选，默认关闭）",
        "任一不过：总分直接归零，不进软评分"
      ]
    },
    {
      "dot": "emerald",
      "title": "三种可替换后端",
      "items": [
        "评审器：mock 确定性（离线可复现）或 LLM",
        "任务执行：runtime_trace 回放 或 Playwright 真跑",
        "LLM 客户端：任意 OpenAI 兼容 chat/completions 端点"
      ]
    },
    {
      "dot": "amber",
      "title": "论文对齐指标",
      "items": [
        "batch 模式比对专家标签 overall 分",
        "Spearman / Kendall tau / MAE / RMSE",
        "ICC(2,1) 衡量多次评分一致性",
        "ablate 命令关闭单一模态，量化其贡献"
      ]
    }
  ]
